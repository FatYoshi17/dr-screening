# Datasets - large, not checked in (see README for download links)
data/raw/*
!data/raw/.gitkeep
# Small, hard-to-reproduce label file (merged from MAPLES-DR, not
# redistributed with the Messidor-2 image set itself) - keep this one,
# unlike the images it labels.
!data/raw/messidor2/
data/raw/messidor2/*
!data/raw/messidor2/messidor2_grades.csv
data/processed/*
!data/processed/.gitkeep

# Generated output
results/*
!results/.gitkeep
!results/samples/
!results/samples/**

# Trained model weights, if/when they exist
*.mat
*.h5
*.onnx
*.onnx.data
data/models/checkpoints_*/

# Python venvs used for one-off export scripts (e.g. exportSegformerONNX.py)
.venv*/
__pycache__/
*.pyc

# Per-request scratch files from backend/main.py's API calls
data/results_api/

# MATLAB
*.asv
*.m~
slprj/
*.slxc

# OS junk
.DS_Store
Thumbs.db
